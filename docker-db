#!/bin/sh
# Run any command against the Docker database instead of the local cluster:
#
#     ./docker-db .venv/bin/python -m door.mcp call infer '{"map": "Ilios"}'
#     ./docker-db .venv/bin/python -m pytest -q
#
# Every entry point honors DATABASE_URL; the port is the one compose.yaml
# publishes for the db service. Host-side tools - the MCP server a Claude Code
# session drives, the board, the tests - read the database Docker built this
# way.
export DATABASE_URL="postgresql://overwatch:${POSTGRES_PASSWORD:-overwatch}@localhost:5433/overwatch"
exec "$@"
