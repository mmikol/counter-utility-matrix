#!/bin/sh
# Run any command against the Docker database instead of the local cluster:
#
#     ./docker-db .venv/bin/python -m db.mcp call infer '{"map": "Ilios"}'
#     ./docker-db .venv/bin/python -m pytest -q
#
# Every entry point honors DATABASE_URL, so this one export is the whole
# bridge; the port is the one compose.yaml publishes for the db service.
# The container builds the database on `docker compose up` (the entrypoint
# builds it when empty or stale); this script is how host-side tools - the
# MCP server a Claude Code session drives, the board, the tests - read what
# Docker built.
export DATABASE_URL="postgresql://overwatch:${POSTGRES_PASSWORD:-overwatch}@localhost:5433/overwatch"
exec "$@"
