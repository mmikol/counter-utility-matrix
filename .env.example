# Copy to .env (gitignored). Loaded by orchestrator, ui, recommend.
#
# OPTIONAL - and it costs money. The API key powers only the "Recommend
# (calls Claude)" button / recommend.py, billed per token at
# console.anthropic.com (no Claude subscription covers it). Everything else -
# pipelines, database, UI, the evidence preview - is free and needs no key.
ANTHROPIC_API_KEY=
# The inference model and its reasoning depth (defaults shown)
OVERWATCH_DB_MODEL=claude-fable-5-1
OVERWATCH_DB_EFFORT=max
