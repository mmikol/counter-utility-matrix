db/raw/
*.csv
!db/data/authored/*.csv

# what the sentry set aside: a person looks first, never a commit
*.md.quarantined

# the bearer token, the uid/gid override
.env

# editors and the OS
.idea/
.vscode/
.DS_Store
._*
