# Python
__pycache__/
*.py[cod]
.venv/

# lint, tests, coverage
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*

# the page caches and the embedded cluster: built, never committed
.cache-blizzard/
.cache-wiki/
/db/psql/cluster/

# the CSV mirror (scraped text and rates) and any stray export
db/raw/
*.csv

# scratch: a throwaway script at the root is never part of the project, and
# `git add -A` has committed two of them
/_*.py
/_*.json

# what the sentry set aside; never committed
*.md.quarantined

# the bearer token, the uid/gid override
.env

# editors and the OS
.idea/
.vscode/
.DS_Store
._*

# Claude Code's worktrees for parallel agents: never part of the tree
/.claude/worktrees/

# desloppify: local scan state, never committed
.desloppify/

# desloppify writes a scorecard image on every scan
scorecard.png

